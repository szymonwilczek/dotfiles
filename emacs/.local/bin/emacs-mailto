#!/usr/bin/env bash
# emacs-mailto URL
#
# Opens a mailto: link as a new message in a frame of the running Emacs
# daemon. mu4e-user-agent (set by mail-mod) makes message-mailto compose
# through mu4e, so the right context and sent-folder are used.

url=${1:-mailto:}
url=${url//\\/\\\\}
url=${url//\"/\\\"}
exec emacsclient -c -a '' --eval "(progn (require 'mu4e) (message-mailto \"$url\"))"
