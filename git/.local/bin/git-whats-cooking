#!/usr/bin/env bash
# git whats-cooking [-s]
# Summary: Report what is cooking locally, waiting for release, and in pull requests.
#
# Prints where the branch pull requests go into stands, after Junio
# Hamano's "What's cooking in git.git":
#
#   What's cooking in <repository> (<date>)
#   --------------------------------------------------
#   <branch> is at <describe> (<n> commits since <last tag>, ...).
#
#   [Cooking]                       local commits not pushed yet
#
#   * <area> (<n> commits)          on the branch itself
#     - <subject>
#   * <topic> (<date>) <n> commits  on a local topic branch
#     on top of <topic>
#
#   [Waiting for release]           pushed since the last tag
#
#   * <area> (<n> commits)
#     - <subject>
#
#   [Ready to merge]                acked, checks passed
#   [Waiting for review]            checks passed, not acked
#   [Checks running]
#   [Checks failing]
#   [Drafts]
#
#   * #<number> <title> (<date opened>) <n> commits
#    <head branch>
#    Milestone <version>, or "No milestone."
#
# A topic is a local branch GitHub has not got, other than a backup*
# one.  It counts the commits it adds to the topics it is built on, and
# names the nearest of them.  Commits on the branch itself are grouped
# by the area before the colon of their subject, in the order the areas
# first appear; a subject without one stands alone.
# A pull request is acked by a review of mine whose text starts with
# "Acked".  Sections with nothing in them are left out.
#
# -s, --send posts the report as a comment to the discussion
# release.discussion names.  The report opens in the Git editor first;
# lines starting with '#' outside a code block are dropped, and an
# empty report or a cancelled edit aborts.
#
# Configuration, from git config:
#
#   release.next        the integration branch; the default branch if unset
#   release.tagPrefix   what tags put before the version; "v" by default
#   release.discussion  the number of the discussion --send posts to

set -euo pipefail

usage() {
    echo "usage: git whats-cooking [-s]" >&2
    exit 2
}

die() {
    echo "git whats-cooking: $*" >&2
    exit 1
}

# Commits of range $1, oldest first, as a list grouped by area
areas() {
    git log --reverse --no-merges --format=%s "$1" |
        awk '
            match($0, /^[^ :]+: /) {
                area = substr($0, 1, RLENGTH - 2)
                if (!(area in n))
                    order[++areas] = area
                list[area] = list[area] "  - " substr($0, RLENGTH + 1) "\n"
                n[area]++
                next
            }
            { order[++areas] = $0; n[$0] = 0 }
            END {
                for (i = 1; i <= areas; i++) {
                    a = order[i]
                    if (n[a] == 0)
                        printf "* %s\n", a
                    else
                        printf "* %s (%d commit%s)\n%s", a, n[a], n[a] == 1 ? "" : "s", list[a]
                }
            }
        '
}

# arguments first, then options
args=()
while (($#)) && [[ $1 != -* ]]; do
    args+=("$1")
    shift
done
send=0
while (($#)); do
    case $1 in
        -s | --send) send=1 ;;
        -h | --help) exec git scripts whats-cooking ;;
        *) usage ;;
    esac
    shift
done
set -- "${args[@]}"
[[ $# -eq 0 ]] || usage

remote=origin
prefix=$(git config --get release.tagPrefix || echo v)
if ! branch=$(git config --get release.next); then
    if branch=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD"); then
        branch=${branch#"$remote"/}
    else
        branch=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
    fi
fi
repository=$(basename "$(git rev-parse --show-toplevel)")
if ((send)); then
    discussion=$(git config --get release.discussion) ||
        die "no release.discussion: set the number of the discussion to post to"
fi

git fetch -q --tags "$remote" "$branch"
me=$(gh api user --jq .login)
if last=$(git describe --tags --abbrev=0 --match "$prefix*" "$remote/$branch" 2>/dev/null); then
    since=$last
    range=$last..$remote/$branch
else
    since="the first commit"
    range=$remote/$branch
fi
merged=$(git rev-list --count --first-parent --merges "$range")

declare -A section
open=0
order=("Ready to merge" "Waiting for review" "Checks running" "Checks failing" "Drafts")

while IFS=$'\t' read -r number draft acked created head milestone title; do
    # the commit count is asked per pull request: listing commits for all
    # of them at once exceeds what GitHub lets one query traverse
    commits=$(gh api "repos/{owner}/{repo}/pulls/$number" --jq .commits)
    if [[ $draft == true ]]; then
        state="Drafts"
    else
        # gh pr checks keeps only the latest run of each check,
        # and exits non-zero while any is failing or pending
        buckets=$(gh pr checks "$number" --json bucket --jq '[.[].bucket] | unique | join(" ")' 2>/dev/null || true)
        if [[ $buckets == *fail* || $buckets == *cancel* ]]; then
            state="Checks failing"
        elif [[ $buckets == *pending* ]]; then
            state="Checks running"
        elif [[ $acked == true ]]; then
            state="Ready to merge"
        else
            state="Waiting for review"
        fi
    fi
    open=$((open + 1))
    section[$state]+="* #$number $title (${created%%T*}) $commits commit$( ((commits == 1)) || echo s)"$'\n'
    section[$state]+=" $head"$'\n'
    if [[ -n $milestone ]]; then
        section[$state]+=" Milestone $milestone."$'\n\n'
    else
        section[$state]+=" No milestone."$'\n\n'
    fi
done < <(gh pr list --state open --base "$branch" --limit 100 \
            --json number,title,isDraft,createdAt,headRefName,milestone,reviews \
            --jq "sort_by(.number) | .[] | [.number, .isDraft,
          any(.reviews[]; .author.login == \"$me\" and (.body | test(\"^\\\\s*Acked\"))),
          .createdAt, .headRefName, (.milestone.title // \"\"), .title] | @tsv")

commits=$(git rev-list --count --no-merges "$range")
# Topics are local branches that GitHub has not got, backups aside.
# A topic owns the commits below its tip down to the next topic tip or
# to what GitHub has; the first tip down its first parents is the topic
# it stands on top of.  Commits GitHub has under another hash, such as
# what a rebase left behind, do not count.
cooking=
if git rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
    cooking=$(areas "$remote/$branch..$branch")
fi
mapfile -t bases < <(
    git for-each-ref --format='%(refname:short)' --exclude='refs/heads/backup*' refs/heads |
        while read -r name; do
            git merge-base "$remote/$branch" "$name" || true
        done | sort -u
        )
upstream=
if ((${#bases[@]})); then
    oldest=$(git merge-base --octopus "${bases[@]}")
    upstream=$(git log -p --no-merges --format='commit %H' "$remote/$branch" "^$oldest" |
                   git patch-id --stable | cut -d' ' -f1)
fi
topics=$(
    {
        printf 'upstream %s\n' $upstream
        git log -p --no-merges --format='commit %H' --exclude='backup*' --branches --not --remotes |
            git patch-id --stable | sed 's/^/patch /'
        git for-each-ref --format='remote %(refname:lstrip=3)' "refs/remotes/$remote"
        git for-each-ref --sort=-committerdate \
            --format='tip %(objectname) %(committerdate:short) %(refname:short)' refs/heads
        echo end
        git rev-list --parents --exclude='backup*' --branches --not --remotes
    } | awk -v branch="$branch" '
        $1 == "upstream" { upstream[$2] = 1; next }
        $1 == "patch" { if ($2 in upstream) landed[$3] = 1; next }
        $1 == "remote" { remote[$2] = 1; next }
        $1 == "tip" {
            if ($4 in remote && $4 != branch)
                pushed[$2] = $4
            if ($4 == branch || $4 ~ /^backup/ || ($4 in remote) || ($2 in owner))
                next
            owner[$2] = $4; date[$4] = $3; order[++tips] = $4; tipsha[$4] = $2
            next
        }
        $1 == "end" { walking = 1; next }
        walking {
            local[$1] = 1
            merge[$1] = NF > 2
            parents[$1] = substr($0, 42)
        }
        END {
            for (i = 1; i <= tips; i++) {
                name = order[i]
                if (!(tipsha[name] in local))
                    continue
                own = 0; on = ""
                # first parents first, so the first tip met is the nearest
                stack[n = 1] = tipsha[name]
                delete seen
                while (n > 0) {
                    c = stack[n--]
                    if (c in seen)
                        continue
                    if (!(c in local)) {
                        if (on == "" && c in pushed)
                            on = pushed[c]
                        continue
                    }
                    seen[c] = 1
                    if (c != tipsha[name] && c in owner) {
                        if (on == "")
                            on = owner[c]
                        continue
                    }
                    if (!merge[c] && !(c in landed))
                        own++
                    k = split(parents[c], p, " ")
                    for (j = k; j >= 1; j--)
                        stack[++n] = p[j]
                }
                if (own == 0)
                    continue
                total += own
                printf "* %s (%s) %d commit%s\n", name, date[name], own, own == 1 ? "" : "s"
                if (on != "")
                    printf "  on top of %s\n", on
            }
            printf "%d\n", total
        }
    '
      )
local=${topics##*$'\n'}
topics=${topics%"$local"}
topics=${topics%$'\n'}
if [[ -n $topics ]]; then
    [[ -z $cooking ]] || cooking+=$'\n'
    cooking+=$topics
fi
if git rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
    local=$((local + $(git rev-list --count --no-merges "$remote/$branch..$branch")))
fi
waiting=$(areas "$range")

plural() { (($1 == 1)) || echo s; }
state="$commits commit$(plural "$commits") since $since"
((merged == 0)) || state+=", $merged pull request$(plural "$merged") merged"
((local == 0)) || state+=", $local cooking locally"

report() {
    local title
    title="What's cooking in $repository ($(LC_ALL=C date '+%a, %d %b %Y'))"
    printf '%s\n%s\n' "$title" "$(printf '%*s' ${#title} '' | tr ' ' -)"
    printf '%s is at %s (%s).\n' \
           "$branch" "$(git describe --tags --always "$remote/$branch")" "$state"
    [[ -z $cooking ]] || printf '\n[Cooking]\n\n%s\n' "$cooking"
    [[ -z $waiting ]] || printf '\n[Waiting for release]\n\n%s\n' "$waiting"
    for stage in "${order[@]}"; do
        [[ -n ${section[$stage]-} ]] || continue
        printf '\n[%s]\n\n%s' "$stage" "${section[$stage]%$'\n'}"
    done
    ((open > 0)) || printf '\nNo open pull requests.\n'
}

if ((!send)); then
    report
    exit 0
fi

# Named like a Git message so with-editor opens it with C-c C-c to send
dir=$(mktemp -d "${TMPDIR:-/tmp}/whats-cooking.XXXXXX")
trap 'rm -rf "$dir"' EXIT
msg=$dir/COOKING_EDITMSG
{
    report
    echo
    echo "# Sending to discussion #$discussion as a comment."
    echo "# Lines starting with '#' outside a code block are dropped;"
    echo "# an empty report aborts."
} >"$msg"

editor=$(git var GIT_EDITOR)
if ! sh -c "$editor \"\$@\"" "$editor" "$msg"; then
    die "editor cancelled, not sending"
fi
body=$(awk '/^```/ { fence = !fence } fence || !/^#/' "$msg" | git stripspace)
[[ -n $body ]] || die "empty report, not sending"

id=$(gh api graphql -F number="$discussion" -f query='
    query($owner: String!, $repo: String!, $number: Int!) {
      repository(owner: $owner, name: $repo) { discussion(number: $number) { id } }
    }' -f owner='{owner}' -f repo='{repo}' --jq .data.repository.discussion.id) ||
    die "no discussion #$discussion"
url=$(gh api graphql -f id="$id" -f body="$body" -f query='
    mutation($id: ID!, $body: String!) {
      addDiscussionComment(input: {discussionId: $id, body: $body}) { comment { url } }
    }' --jq .data.addDiscussionComment.comment.url)
echo "git whats-cooking: sent to $url" >&2
