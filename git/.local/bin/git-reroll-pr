#!/usr/bin/env bash
# git reroll-pr <number> [--send]
# Created for managing my LOTA project
#
# Prints what the local branch of open pull request <number> changes
# against the head GitHub has, as the comment that announces a new
# version of a patch series:
#
#   v<n>: range-diff against v<n-1> (<GitHub head>) | <count> changed, ...
#
#   <git range-diff of the two series, each taken from the base branch>
#
# v1 is the series the pull request was opened with; <n> is one more
# than the last version announced in a comment, so the first rework is v2.
#
# --send also posts the comment to the pull request.  Send before
# git push-prs pushes: once GitHub has the local branch there is no
# difference left to show.
#
# The comment opens in the Git editor first, with a commented-out
# changelog under its first line:
#
#   Changes in v<n>:
#   - <one line per commit range-diff does not show as unchanged>
#
# Lines starting with '#' outside a code block are dropped, so the
# changelog is sent only where it is uncommented, and range-diff's own
# "## ... ##" headers stay.  An empty comment or a cancelled edit aborts.
#
# A pull request that is not open, has no local branch, or whose local
# branch already matches GitHub is refused, as git push-prs skips it.

set -euo pipefail
shopt -s inherit_errexit

if [[ ${TERM-} == dumb ]]; then
    export NO_COLOR=1 GH_SPINNER_DISABLED=1
fi

usage() {
    echo "usage: git reroll-pr <pr-number> [--send]" >&2
    exit 2
}

die() {
    echo "git reroll-pr: $*" >&2
    exit 1
}

[[ $# -ge 1 && $# -le 2 && $1 =~ ^[0-9]+$ ]] || usage
number=$1
send=0
if [[ $# -eq 2 ]]; then
    [[ $2 == --send ]] || usage
    send=1
fi

remote=origin
# A GitHub comment holds at most 65536 characters
limit=65536

IFS=$'\t' read -r state head oid base < <(gh pr view "$number" \
                                             --json state,headRefName,headRefOid,baseRefName \
                                             --jq '[.state, .headRefName, .headRefOid, .baseRefName] | @tsv')

[[ $state == OPEN ]] || die "#$number ($head) is $state"
local_oid=$(git rev-parse -q --verify "refs/heads/$head^{commit}") ||
    die "#$number ($head) has no local branch"
[[ $local_oid != "$oid" ]] || die "#$number ($head) already matches GitHub"

git fetch -q "$remote" "$base"
git cat-file -e "$oid^{commit}" 2>/dev/null || git fetch -q "$remote" "refs/pull/$number/head"

bases=$(
    for ref in "refs/remotes/$remote/$base" "refs/heads/$base"; do
        git rev-parse -q --verify "$ref^{commit}" >/dev/null || continue
        git reflog --format=%H "$ref" 2>/dev/null || true
    done | awk '!seen[$0]++'
     )

fork_of() {
    local fork c f
    fork=$(git merge-base "$1" "$remote/$base")
    for c in $bases; do
        f=$(git merge-base "$1" "$c") || continue
        if git merge-base --is-ancestor "$fork" "$f"; then
            fork=$f
        fi
    done
    echo "$fork"
}

old_fork=$(fork_of "$oid")
new_fork=$(fork_of "$local_oid")

prev=$(gh api --paginate "repos/{owner}/{repo}/issues/$number/comments" \
          --jq '.[].body | capture("^v(?<n>[0-9]+): range-diff").n' |
           sort -n | tail -n 1)
prev=${prev:-1}

rd=$(git range-diff --no-color "$old_fork..$oid" "$new_fork..$local_oid")

counts=$(
    printf '%s\n' "$rd" |
        awk '
            /^ *(-+|[0-9]+): +(-+|[0-9a-f]+) [=!<>] / { n[$3]++ }
            END {
                split("< > ! =", op, " ")
                split("dropped new changed unchanged", name, " ")
                for (i = 1; i <= 4; i++)
                    if (n[op[i]])
                        out = out (out == "" ? "" : ", ") n[op[i]] " " name[i]
                print out
            }
        '
      )

subject=$(printf 'v%d: range-diff against v%d (%s) | %s' \
                 $((prev + 1)) "$prev" "${oid:0:12}" "$counts")

blocks=$(
    printf '%s\n' "$rd" |
        awk '
            /^ *(-+|[0-9]+): +(-+|[0-9a-f]+) [=!<>] / { kind = "" }
            !/^ *(-+|[0-9]+): +(-+|[0-9a-f]+) [=!<>] / {
                kind = "patch"
                sub(/^    /, "")
            }
            !open || kind != cur {
                if (open)
                    print "```\n"
                print "```" kind
                cur = kind
                open = 1
            }
            { print }
            END { if (open) print "```" }
        '
      )

if ((!send)); then
    printf '%s\n\n%s\n' "$subject" "$blocks"
    exit 0
fi

# Named PULLREQ_EDITMSG so Magit's with-editor opens it as a message
dir=$(mktemp -d "${TMPDIR:-/tmp}/reroll-pr.XXXXXX")
trap 'rm -rf "$dir"' EXIT
msg=$dir/PULLREQ_EDITMSG

{
    printf '%s\n\n' "$subject"
    echo "# Changes in v$((prev + 1)):"
    printf '%s\n' "$rd" |
        awk '
            match($0, /^ *(-+|[0-9]+): +(-+|[0-9a-f]+) [=!<>] +(-+|[0-9]+): +(-+|[0-9a-f]+) /) {
                op = $3
                title = substr($0, RLENGTH + 1)
                if (op == "<")
                    print "# - Dropped \"" title "\": "
                else if (op == ">")
                    print "# - New \"" title "\": "
                else if (op == "!")
                    print "# - \"" title "\": "
            }
        '
    echo
    printf '%s\n\n' "$blocks"
    echo "# Sending v$((prev + 1)) to pull request #$number ($head) as a comment."
    echo "# Lines starting with '#' outside a code block are dropped;"
    echo "# an empty comment aborts."
} >"$msg"

editor=$(git var GIT_EDITOR)
if ! sh -c "$editor \"\$@\"" "$editor" "$msg"; then
    die "editor cancelled, not sending"
fi

body=$(awk '/^```/ { fence = !fence } fence || !/^#/' "$msg" | git stripspace)
[[ -n $body ]] || die "empty comment, not sending"

((${#body} <= limit)) || die "#$number: comment exceeds $limit characters, not sent"
gh pr comment "$number" --body "$body" >/dev/null
echo "git reroll-pr: #$number: v$((prev + 1)) sent" >&2

git push-prs "$number"
