#!/usr/bin/env bash
# git release-open <version> [-n]
# Summary: Open the release pull request from the next branch into the default branch.
#
# Opens the pull request that brings release <version> from the
# integration branch <next> to the default branch <stable>:
#
#   Merge <next> updates for <version>
#
# labelled release.label, if set, in milestone <version>, with a Markdown
# description of what git request-pull would say:
#
#   Pull of [`<previous release>...<end>`](<compare URL>) into `<stable>`.
#
#   |           |                 Commit             |                      |
#   |-----------|------------------------------------|----------------------|
#   | **Since** | <sha of the previous release>      | `<subject>` · <date> |
#   | **Up to** | <sha of the end>                   | `<subject>` · <date> |
#   | **Fetch** | `git fetch <repository URL> <ref>` |                      |
#
#   ----------------------------------------------------------------
#   Merged pull requests:
#
#   - #<number>                 GitHub shows each one's title
#
#   ----------------------------------------------------------------
#   ```diff
#   <dirstat>
#
#     <n> files changed
#   + <n> insertions(+)
#   - <n> deletions(-)
#   ```
#
# The end is the tag <prefix><version>, or <next> before the tag exists.
# The previous release is the last stable <prefix>* tag before the end
# commit.
# The title and the description open in the Git editor first, the title
# as the first line, and the pull request is opened only once they are
# accepted; an empty message or a cancelled edit aborts.
# It is refused while a pull request from <next> to <stable> is open.
#
# -n, --dry-run prints the description and opens nothing.
#
# Configuration, from git config:
#
#   release.next       the integration branch; required
#   release.label      the label of release pull requests; none if unset
#   release.tagPrefix  what tags put before the version; "v" by default

set -euo pipefail

if [[ ${TERM-} == dumb ]]; then
    export NO_COLOR=1 GH_SPINNER_DISABLED=1
fi

usage() {
    echo "usage: git release-open <version> [-n]" >&2
    exit 2
}

die() {
    echo "git release-open: $*" >&2
    exit 1
}

# arguments first, then options
args=()
while (($#)) && [[ $1 != -* ]]; do
    args+=("$1")
    shift
done
dry_run=0
while (($#)); do
    case $1 in
        -n | --dry-run) dry_run=1 ;;
        -h | --help) exec git scripts release-open ;;
        *) usage ;;
    esac
    shift
done
set -- "${args[@]}"
[[ $# -eq 1 && -n $1 ]] || usage
version=$1

remote=origin
branch=$(git config --get release.next) ||
    die "no release.next: this project has no integration branch to release from"
if stable=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD"); then
    stable=${stable#"$remote"/}
else
    stable=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
fi
prefix=$(git config --get release.tagPrefix || echo v)
label=$(git config --get release.label || true)

if git rev-parse -q --verify "refs/tags/$prefix$version^{commit}" >/dev/null; then
    end=$prefix$version
    ref=tags/$prefix$version
else
    end=$remote/$branch
    ref=$branch
fi

base=$(git describe --tags --abbrev=0 --match "$prefix*" --exclude "$prefix*-*" "$end^" 2>/dev/null) ||
    die "no stable release before $end"

notes=$(git release-notes "$version" | sed -E 's/^- (#[0-9]+) .*/- \1/')
url=$(gh repo view --json url --jq .url)
rule=$(printf '%064d' 0 | tr 0 -)
fence='```'

row() {
    git show -s --format="| **$1** | %H | \`%s\` · %cs |" "$2^{commit}"
}

stat() {
    git diff -M --shortstat "$base" "$end" | tr ',' '\n' | sed -E \
                                                               -e 's/^ *//' \
                                                               -e 's/^([0-9]+ insertion)/+ \1/' \
                                                               -e 's/^([0-9]+ deletion)/- \1/' \
                                                               -e 's/^([0-9]+ file)/  \1/'
}

compare=${end#"$remote/"}

desc=$(
    printf 'Pull of [`%s...%s`](%s/compare/%s...%s) into `%s`.\n\n' \
           "$base" "$compare" "$url" "$base" "$compare" "$stable"
    printf '| | Commit | |\n|---|---|---|\n'
    row Since "$base"
    row 'Up to' "$end"
    printf '| **Fetch** | `git fetch %s %s` | |\n\n' "$url" "$ref"
    printf '%s\n%s\n\n' "$rule" "$notes"
    printf '%s\n%sdiff\n' "$rule" "$fence"
    git diff -M --dirstat "$base" "$end"
    echo
    stat
    printf '%s\n' "$fence"
    )

if ((dry_run)); then
    printf '%s\n' "$desc"
    exit 0
fi

open=$(gh pr list --state open --base "$stable" --head "$branch" --json number --jq '.[0].number // empty')
[[ -z $open ]] || die "#$open already brings $branch to $stable"

# Named PULLREQ_EDITMSG so Magit's with-editor opens it as a message
dir=$(mktemp -d "${TMPDIR:-/tmp}/release-open.XXXXXX")
trap 'rm -rf "$dir"' EXIT
msg=$dir/PULLREQ_EDITMSG

cat >"$msg" <<-EOF
	Merge $branch updates for $version

	$desc

	# Opening the pull request from $branch to $stable; the first line is its title.
	# Lines starting with '#' are dropped; an empty message aborts.
EOF

editor=$(git var GIT_EDITOR)
if ! sh -c "$editor \"\$@\"" "$editor" "$msg"; then
    echo "git release-open: editor cancelled, not opening" >&2
    exit 1
fi

git stripspace --strip-comments <"$msg" >"$msg.clean"
mv "$msg.clean" "$msg"
if [[ ! -s $msg ]]; then
    echo "git release-open: empty message, not opening" >&2
    exit 1
fi

gh pr create --base "$stable" --head "$branch" \
   --title "$(head -n 1 "$msg")" \
   ${label:+--label "$label"} --milestone "$version" \
   --body "$(tail -n +3 "$msg")"
