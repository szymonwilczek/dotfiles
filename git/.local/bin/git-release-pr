#!/usr/bin/env bash
# git release-pr [-n] <version>
# Created for managing my LOTA project
#
# Opens the pull request that brings release <version> from lota-next
# to main:
#
#   Merge lota-next updates for <version>
#
# labelled merge-release, in milestone <version>, with a description laid
# out like git request-pull, with the release notes from git release-for
# in place of the tag message:
#
#   The following changes since commit <sha of the previous release>:
#
#     <subject> (<date>)
#
#   are available in the Git repository at:
#
#     <repository URL> <tags/v<version>, or lota-next before the tag exists>
#
#   for you to fetch changes up to <sha>:
#
#     <subject> (<date>)
#
#   ----------------------------------------------------------------
#   <git release-for <version>>
#
#   ----------------------------------------------------------------
#   <dirstat and the files changed line>
#
# The previous release is the last stable v* tag before the end commit.
# It is refused while a pull request from lota-next to main is open.
#
# -n prints the description and opens nothing.

set -euo pipefail

usage() {
    echo "usage: git release-pr [-n] <version>" >&2
    exit 2
}

dry_run=0
if [[ ${1-} == -n ]]; then
    dry_run=1
    shift
fi
[[ $# -eq 1 && -n $1 ]] || usage
version=$1

remote=origin
branch=lota-next

if git rev-parse -q --verify "refs/tags/v$version^{commit}" >/dev/null; then
    end=v$version
    ref=tags/v$version
else
    end=$remote/$branch
    ref=$branch
fi

if ! base=$(git describe --tags --abbrev=0 --match 'v*' --exclude 'v*-*' "$end^" 2>/dev/null); then
    echo "git release-pr: no stable release before $end" >&2
    exit 1
fi

notes=$(git release-for "$version")
url=$(gh repo view --json url --jq .url)
rule=$(printf '%064d' 0 | tr 0 -)

commit() { git show -s --format='%H:%n%n  %s (%ci)' "$1^{commit}"; }

desc=$(
    cat <<EOF
The following changes since commit $(commit "$base")

are available in the Git repository at:

  $url $ref

for you to fetch changes up to $(commit "$end")

$rule
$notes

$rule
$(git diff -M --dirstat "$base" "$end")
$(git diff -M --shortstat "$base" "$end")
EOF
    )

if ((dry_run)); then
    printf '%s\n' "$desc"
    exit 0
fi

open=$(gh pr list --state open --base main --head "$branch" --json number --jq '.[0].number // empty')
if [[ -n $open ]]; then
    echo "git release-pr: #$open already brings $branch to main" >&2
    exit 1
fi

gh pr create --base main --head "$branch" \
   --title "Merge $branch updates for $version" \
   --label merge-release --milestone "$version" \
   --body "$desc"
