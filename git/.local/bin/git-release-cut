#!/usr/bin/env bash
# git release-cut <version> [-n]
# Summary: Bump the version on the release branch and tag the release or release candidate.
#
# Bumps the version in release.versionFile on the release branch and tags
# the bump, the way every release and release candidate is cut:
#
#   build: <version>
#
#   <git release-notes <version>, wrapped to 72 columns; stable releases only>
#
#   Signed-off-by: <user.name> <user.email>
#
# The commit is signed, and so is the annotated tag <prefix><version>,
# whose message is "<name> <version>".
# Both messages open in the Git editor, the commit's first, and nothing is
# changed until both are accepted; an empty message or a cancelled edit aborts.
# The push that publishes both is printed.
#
# -n, --dry-run prints the commit message and changes nothing.
#
# Configuration, from git config:
#
#   release.next            the integration branch, which releases are cut
#                           on; the default branch if unset
#   release.versionFile     the file that holds the version, from the top
#                           of the repository; required
#   release.versionPattern  an awk regular expression for what comes before
#                           the version on its line, such as "^;; Version: ";
#                           if unset, the version is the whole first line
#   release.name            the project name in the tag message; the name
#                           of the repository if unset
#   release.tagPrefix       what tags put before the version; "v" by default

set -euo pipefail
shopt -s inherit_errexit

if [[ ${TERM-} == dumb ]]; then
    export NO_COLOR=1 GH_SPINNER_DISABLED=1
fi

usage() {
    echo "usage: git release-cut <version> [-n]" >&2
    exit 2
}

die() {
    echo "git release-cut: $*" >&2
    exit 1
}

# arguments first, then options
args=()
while (($#)) && [[ $1 != -* ]]; do
    args+=("$1")
    shift
done
dry_run=0
while (($#)); do
    case $1 in
        -n | --dry-run) dry_run=1 ;;
        -h | --help) exec git scripts release-cut ;;
        *) usage ;;
    esac
    shift
done
set -- "${args[@]}"
[[ $# -eq 1 && $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?$ ]] || usage
version=$1

remote=origin
top=$(git rev-parse --show-toplevel)
file=$(git config --get release.versionFile) ||
    die "no release.versionFile; set it to the file that holds the version"
pattern=$(git config --get release.versionPattern || true)
name=$(git config --get release.name || basename "$top")
tag=$(git config --get release.tagPrefix || echo v)$version
if ! branch=$(git config --get release.next); then
    if branch=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD"); then
        branch=${branch#"$remote"/}
    else
        branch=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
    fi
fi

# the version $file holds: what follows $pattern on the first line it
# matches, or the whole first line
current() {
    awk -v re="$pattern" '
	re == "" { print; found = 1; exit }
	match($0, re) { print substr($0, RSTART + RLENGTH); found = 1; exit }
	END { exit !found }
	' "$top/$file"
}

# $file with the version it holds replaced by $1
bumped() {
    awk -v re="$pattern" -v version="$1" '
	!done && re == "" { $0 = version; done = 1 }
	!done && match($0, re) { $0 = substr($0, 1, RSTART + RLENGTH - 1) version; done = 1 }
	{ print }
	' "$top/$file"
}

[[ $(git symbolic-ref -q --short HEAD) == "$branch" ]] || die "not on $branch"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "$tag already exists"
[[ -f $top/$file ]] || die "no $file, which release.versionFile names"
old=$(current) || die "no line of $file matches release.versionPattern"
[[ $old != "$version" ]] || die "$file already says $version"
git diff --quiet HEAD -- || die "the working tree has uncommitted changes"
git fetch -q "$remote" "$branch"
git merge-base --is-ancestor "$remote/$branch" HEAD || die "$branch is behind $remote/$branch"

# a list item wrapped to width $1, continued under its text
wrap() {
    awk -v width="$1" '
	{
		hang = match($0, /^- /) ? "  " : ""
		n = split($0, words, " ")
		line = ""
		for (i = 1; i <= n; i++) {
			if (line != "" && length(line) + 1 + length(words[i]) > width) {
				print line
				line = hang words[i]
			} else {
				line = line == "" ? words[i] : line " " words[i]
			}
		}
		print line
	}
	'
}

msg=$(
    echo "build: $version"
    echo
    if [[ $version != *-* ]]; then
        git release-notes "$version" | wrap 72
        echo
    fi
    echo "Signed-off-by: $(git config user.name) <$(git config user.email)>"
   )

if ((dry_run)); then
    printf '%s\n' "$msg"
    exit 0
fi

dir=$(mktemp -d "${TMPDIR:-/tmp}/release-cut.XXXXXX")
trap 'rm -rf "$dir"' EXIT
editor=$(git var GIT_EDITOR)

# Opens $1, holding $2 and the comment $3, in the Git editor and leaves
# it with the comments dropped; named COMMIT_EDITMSG or TAG_EDITMSG,
# Magit's with-editor opens it as that kind of message
edit() {
    {
        printf '%s\n\n' "$2"
        printf '# %s\n' "$3" "Lines starting with '#' are dropped; an empty message aborts."
    } >"$1"
    sh -c "$editor \"\$@\"" "$editor" "$1" || die "editor cancelled, nothing changed"
    git stripspace --strip-comments <"$1" >"$1.clean"
    mv "$1.clean" "$1"
    [[ -s $1 ]] || die "empty message, nothing changed"
}

edit "$dir/COMMIT_EDITMSG" "$msg" "The commit bumping $file from $old to $version on $branch."
edit "$dir/TAG_EDITMSG" "$name $version" "The message of tag $tag."

# written in place, so that the file keeps its mode
bumped "$version" >"$dir/bumped"
cat "$dir/bumped" >"$top/$file"
git commit -q -S -F "$dir/COMMIT_EDITMSG" -- "$top/$file"
git tag -s -F "$dir/TAG_EDITMSG" "$tag"

git log -1 --format='%h %s' "$tag"
echo "git push --atomic $remote $branch $tag"
