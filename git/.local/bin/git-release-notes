#!/usr/bin/env bash
# git release-notes <version>
# Summary: Print the release notes, from a milestone or from the commits since the last release.
#
# Prints the release notes body listing every merged pull request whose
# milestone is <version>:
#
#   Merged pull requests:
#
#   - #<number> <title>
#   ...
#
#   ---
#
#   - #<number> <title>
#   ...
#
# A rule closes the pull requests each release candidate
# <prefix><version>-rc<n> took in, those first released by a candidate
# tag that contains their merge; within a candidate they are listed by
# number.
#
# With release.next set, the pull requests into the default branch are
# left out: they are the ones that carry a release there.
#
# With release.notes set to "commits", lists instead the commits since
# the last stable release, oldest first, for projects without milestones:
#
#   Changes since <previous release>:
#
#   - <commit title>
#   ...
#
# They run up to the tag <prefix><version>, or to HEAD before it exists.
#
# Nothing is published; the output is meant to be pasted into the release.
#
# Configuration, from git config:
#
#   release.next       the integration branch, if the project has one
#   release.notes      "milestone" or "commits"; "milestone" by default
#   release.tagPrefix  what tags put before the version; "v" by default

set -euo pipefail

usage() {
    echo "usage: git release-notes <version>" >&2
    exit 2
}

# arguments first, then options
args=()
while (($#)) && [[ $1 != -* ]]; do
    args+=("$1")
    shift
done
while (($#)); do
    case $1 in
        -h | --help) exec git scripts release-notes ;;
        *) usage ;;
    esac
    shift
done
set -- "${args[@]}"
[[ $# -eq 1 && -n $1 ]] || usage
version=$1

remote=origin
next=$(git config --get release.next || true)
prefix=$(git config --get release.tagPrefix || echo v)
mode=$(git config --get release.notes || echo milestone)

if [[ $mode == commits ]]; then
    end=HEAD
    git rev-parse -q --verify "refs/tags/$prefix$version^{commit}" >/dev/null && end=$prefix$version
    if base=$(git describe --tags --abbrev=0 --match "$prefix*" --exclude "$prefix*-*" \
                  --exclude "$prefix$version" "$end" 2>/dev/null); then
        echo "Changes since $base:"
        range=$base..$end
    else
        echo "Changes:"
        range=$end
    fi
    echo
    commits=$(git log --reverse --no-merges --format='- %s' "$range")
    if [[ -z $commits ]]; then
        echo "git release-notes: no commits in $range" >&2
        exit 1
    fi
    printf '%s\n' "$commits"
    exit 0
fi
[[ $mode == milestone ]] || { echo "git release-notes: release.notes is $mode, not milestone or commits" >&2; exit 1; }

# with an integration branch, the release pull requests go into the
# default branch and are not listed
skip=
if [[ -n $next ]]; then
    if stable=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD"); then
        stable=${stable#"$remote"/}
    else
        stable=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
    fi
    skip=" and .baseRefName != \"$stable\""
fi

prs=$(gh pr list --state merged --limit 1000 \
         --search "milestone:\"$version\"" \
         --json number,title,milestone,baseRefName,mergeCommit \
         --jq "[.[] | select(.milestone.title == \"$version\"$skip)] | sort_by(.number)
          | .[] | [.number, .mergeCommit.oid, .title] | @tsv")

if [[ -z $prs ]]; then
    echo "git release-notes: no merged pull requests in milestone $version" >&2
    exit 1
fi

mapfile -t rcs < <(git tag -l "$prefix$version-rc*" --sort=v:refname)

# index into rcs of the first candidate that released a merge,
# or the number of candidates when none did yet
candidate() {
    local i
    for i in "${!rcs[@]}"; do
        if git merge-base --is-ancestor "$1" "${rcs[i]}" 2>/dev/null; then
            echo "$i"
            return
        fi
    done
    echo "${#rcs[@]}"
}

echo 'Merged pull requests:'
group=
while IFS=$'\t' read -r rc number title; do
    [[ -z $group || $rc == "$group" ]] || printf '\n---\n'
    [[ $rc == "$group" ]] || echo
    group=$rc
    echo "- #$number $title"
done < <(
    while IFS=$'\t' read -r number merge title; do
        printf '%s\t%s\t%s\n' "$(candidate "$merge")" "$number" "$title"
    done <<<"$prs" | sort -t $'\t' -k1,1n -k2,2n
     )
