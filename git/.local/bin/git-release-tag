#!/usr/bin/env bash
# git release-tag [-n] <version>
# Created for managing my LOTA project
#
# Bumps VERSION on lota-next and tags the bump, the way every LOTA
# release and release candidate is cut:
#
#   build: <version>
#
#   <git release-for <version>, wrapped to 72 columns; stable releases only>
#
#   Signed-off-by: <user.name> <user.email>
#
# The commit is signed, and so is the annotated tag v<version>, whose
# message is "LOTA <version>".
# Both messages open in the Git editor, the commit's first, and nothing is
# changed until both are accepted; an empty message or a cancelled edit aborts.
# The push that publishes both is printed.
#
# -n prints the commit message and changes nothing.

set -euo pipefail
shopt -s inherit_errexit

if [[ ${TERM-} == dumb ]]; then
    export NO_COLOR=1 GH_SPINNER_DISABLED=1
fi

usage() {
    echo "usage: git release-tag [-n] <version>" >&2
    exit 2
}

die() {
    echo "git release-tag: $*" >&2
    exit 1
}

dry_run=0
if [[ ${1-} == -n ]]; then
    dry_run=1
    shift
fi
[[ $# -eq 1 && $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?$ ]] || usage
version=$1
tag=v$version

remote=origin
branch=lota-next

top=$(git rev-parse --show-toplevel)
[[ $(git symbolic-ref -q --short HEAD) == "$branch" ]] || die "not on $branch"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "$tag already exists"
[[ $(sed -n 1p "$top/VERSION") != "$version" ]] || die "VERSION already says $version"
git diff --quiet HEAD -- || die "the working tree has uncommitted changes"
git fetch -q "$remote" "$branch"
git merge-base --is-ancestor "$remote/$branch" HEAD || die "$branch is behind $remote/$branch"

# a list item wrapped to width $1, continued under its text
wrap() {
    awk -v width="$1" '
	{
		hang = match($0, /^- /) ? "  " : ""
		n = split($0, words, " ")
		line = ""
		for (i = 1; i <= n; i++) {
			if (line != "" && length(line) + 1 + length(words[i]) > width) {
				print line
				line = hang words[i]
			} else {
				line = line == "" ? words[i] : line " " words[i]
			}
		}
		print line
	}
	'
}

msg=$(
    echo "build: $version"
    echo
    if [[ $version != *-* ]]; then
        git release-for "$version" | wrap 72
        echo
    fi
    echo "Signed-off-by: $(git config user.name) <$(git config user.email)>"
   )

if ((dry_run)); then
    printf '%s\n' "$msg"
    exit 0
fi

dir=$(mktemp -d "${TMPDIR:-/tmp}/release-tag.XXXXXX")
trap 'rm -rf "$dir"' EXIT
editor=$(git var GIT_EDITOR)

# Opens $1, holding $2 and the comment $3, in the Git editor and leaves
# it with the comments dropped; named COMMIT_EDITMSG or TAG_EDITMSG,
# Magit's with-editor opens it as that kind of message
edit() {
    {
        printf '%s\n\n' "$2"
        printf '# %s\n' "$3" "Lines starting with '#' are dropped; an empty message aborts."
    } >"$1"
    sh -c "$editor \"\$@\"" "$editor" "$1" || die "editor cancelled, nothing changed"
    git stripspace --strip-comments <"$1" >"$1.clean"
    mv "$1.clean" "$1"
    [[ -s $1 ]] || die "empty message, nothing changed"
}

edit "$dir/COMMIT_EDITMSG" "$msg" "The commit bumping VERSION to $version on $branch."
edit "$dir/TAG_EDITMSG" "LOTA $version" "The message of tag $tag."

echo "$version" >"$top/VERSION"
git commit -q -S -F "$dir/COMMIT_EDITMSG" -- "$top/VERSION"
git tag -s -F "$dir/TAG_EDITMSG" "$tag"

git log -1 --format='%h %s' "$tag"
echo "git push --atomic $remote $branch $tag"
