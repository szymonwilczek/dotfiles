" --- Lightline Customization ---
let g:lightline = {}
let g:lightline.colorscheme = 'gruvbox_material'
let g:lightline.active = {'left': [['mode', 'paste'], ['readonly', 'relativepath', 'modified']], 'right': [['lineinfo'], ['filetype', 'coc_diagnostics', 'fileencoding', 'filesize', 'gitbranch']]}
let g:lightline.component_function = {'gitbranch': 'FugitiveHead', 'filesize': 'LightlineFilesize', 'relativepath': 'LightlineRelativePath', 'coc_diagnostics': 'LightlineCocDiagnostics'}

function! LightlineFilesize()
  let l:bytes = getfsize(expand('%:p'))
  if l:bytes <= 0 | return '' | endif
  if l:bytes < 1024 | return l:bytes . ' B' | endif
  if l:bytes < 1048576 | return (l:bytes / 1024) . ' KiB' | endif
  return (l:bytes / 1048576) . ' MiB'
endfunction

function! LightlineRelativePath()
  return expand('%:p:.')
endfunction

function! LightlineCocDiagnostics()
  let info = get(b:, 'coc_diagnostic_info', {})
  if empty(info) | return '' | endif
  let msgs = []
  if get(info, 'error', 0)
    call add(msgs, 'E:' . info['error'])
  endif
  if get(info, 'warning', 0)
    call add(msgs, 'W:' . info['warning'])
  endif
  return join(msgs, ' ')
endfunction

