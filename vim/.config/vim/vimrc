" --- Harpoon Implementation ---
let g:harpoon_files = []
function! HarpoonAdd()
  let l:file = expand('%:p')
  if len(g:harpoon_files) < 4
    if index(g:harpoon_files, l:file) == -1
      call add(g:harpoon_files, l:file)
      echo "Harpoon: Added " . l:file
    else
      echo "Harpoon: File already exists in marks."
    endif
  else
    echo "Harpoon: Maximum of 4 files reached."
  endif
endfunction

function! HarpoonJump(n)
  let l:idx = a:n - 1
  if l:idx < len(g:harpoon_files)
    execute 'edit ' . g:harpoon_files[l:idx]
  else
    echo "Harpoon slot " . a:n . " is empty"
  endif
endfunction

function! HarpoonMenu()
  let l:list = []
  for i in range(len(g:harpoon_files))
    call add(l:list, {'text': g:harpoon_files[i], 'filename': g:harpoon_files[i], 'lnum': 1})
  endfor
  call setqflist(l:list)
  copen
endfunction

" --- Lazygit ---
function! OpenLazygitFloating()
  let l:width = float2nr(&columns * 0.9)
  let l:height = float2nr(&lines * 0.9)
  let l:row = float2nr((&lines - l:height) / 2)
  let l:col = float2nr((&columns - l:width) / 2)

  let l:buf = term_start('lazygit', {
  \ 'hidden': 1,
  \ 'term_finish': 'close'
  \ })

  call popup_create(l:buf, {
  \ 'line': l:row,
  \ 'col': l:col,
  \ 'minwidth': l:width,
  \ 'minheight': l:height,
  \ 'maxwidth': l:width,
  \ 'maxheight': l:height,
  \ 'border': [1,1,1,1],
  \ 'borderchars': ['─', '│', '─', '│', '╭', '╮', '╯', '╰'],
  \ 'title': ' Lazygit ',
  \ })
endfunction
command! Lazygit call OpenLazygitFloating()

