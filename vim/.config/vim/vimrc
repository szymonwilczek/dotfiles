" Yank highlight
augroup highlight_yank
  autocmd!
  autocmd TextYankPost * silent! call <SID>highlight_yank()
augroup END

function! s:highlight_yank()
  let l:pos = getpos("'[")
  let l:end = getpos("']")
  if l:pos[1] > 0 && l:end[1] > 0
    let l:match_id = matchaddpos('IncSearch', [[l:pos[1], l:pos[2], l:end[1] - l:pos[1] + 1]])
    call timer_start(200, {-> matchdelete(l:match_id)})
  endif
endfunction

