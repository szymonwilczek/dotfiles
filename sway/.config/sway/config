### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $menu fuzzel
set $explorer QT_QPA_PLATFORMTHEME=kde dolphin
set $taskmanager plasma-systemmonitor

# Execs
exec dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME=kde

exec swaync
exec ~/.config/sway/scripts/sh/waybar.sh
exec ~/.config/sway/scripts/sh/modal.sh pipewire-mixer --hidden
exec ~/.config/sway/scripts/sh/modal.sh audio-switcher --hidden
exec ~/.config/sway/scripts/sh/modal.sh powermenu --hidden
exec ~/.config/sway/scripts/sh/modal.sh wallpaper --hidden
exec ~/.config/sway/scripts/sh/modal.sh calculator --hidden
exec ~/.config/sway/scripts/sh/modal.sh net-info --hidden
exec wl-paste --watch cliphist store

# Output configuration
output * subpixel none
# output * render_bit_depth 10
output HDMI-A-1 mode 1920x1080@75Hz pos 0 0
output DP-2 mode 1920x1080@179.821Hz pos 1920 0
output DP-2 max_render_time 2
output DP-1 mode 1600x900@77Hz pos 3840 0

# Per-monitor workspaces to outputs
workspace "DP-2:1" output DP-2
workspace "DP-2:2" output DP-2
workspace "DP-2:3" output DP-2
workspace "DP-2:4" output DP-2
workspace "DP-2:5" output DP-2
workspace "DP-2:6" output DP-2
workspace "DP-2:7" output DP-2
workspace "DP-2:8" output DP-2
workspace "DP-2:9" output DP-2
workspace "DP-2:10" output DP-2
workspace "HDMI-A-1:1" output HDMI-A-1
workspace "HDMI-A-1:2" output HDMI-A-1
workspace "HDMI-A-1:3" output HDMI-A-1
workspace "HDMI-A-1:4" output HDMI-A-1
workspace "HDMI-A-1:5" output HDMI-A-1
workspace "HDMI-A-1:6" output HDMI-A-1
workspace "HDMI-A-1:7" output HDMI-A-1
workspace "HDMI-A-1:8" output HDMI-A-1
workspace "HDMI-A-1:9" output HDMI-A-1
workspace "HDMI-A-1:10" output HDMI-A-1
workspace "DP-1:1" output DP-1
workspace "DP-1:2" output DP-1
workspace "DP-1:3" output DP-1
workspace "DP-1:4" output DP-1
workspace "DP-1:5" output DP-1
workspace "DP-1:6" output DP-1
workspace "DP-1:7" output DP-1
workspace "DP-1:8" output DP-1
workspace "DP-1:9" output DP-1
workspace "DP-1:10" output DP-1

# Seat & Cursor configuration
seat * xcursor_theme Adwaita 24
exec_always gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'
exec_always gsettings set org.gnome.desktop.interface cursor-size 24
exec_always kwriteconfig6 --notify --file kcminputrc --group Mouse --key cursorTheme Adwaita
exec_always kwriteconfig6 --notify --file kcminputrc --group Mouse --key cursorSize 24

# Gaps & Borders configuration
smart_gaps on
hide_edge_borders smart

# Idle configuration
# Im not using it, but maybe someday

# Input configuration
input type:keyboard {
    xkb_layout "pl"
    xkb_options caps:ctrl_modifier
    repeat_delay 280
    repeat_rate 40
}

input type:pointer {
    pointer_accel 0.0
    accel_profile flat
}

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec env GDK_BACKEND=wayland emacsclient -c -a ''
bindsym $mod+a kill
bindsym $mod+s exec $menu
bindsym $mod+e exec $explorer
bindsym $mod+period exec carmenta --vim --disable-gifs --close-on-select --scale 1.15
bindsym Ctrl+Shift+Escape exec $taskmanager

floating_modifier $mod normal

bindsym $mod+Shift+c exec sh -c '~/.config/sway/scripts/sh/generate-tiled-rules.sh; swaymsg reload; pkill -x waybar; ~/.config/sway/scripts/sh/waybar.sh'

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Ctrl+$left mark --add --replace _swap; focus left; swap container with mark _swap; [con_mark="^_swap$"] focus; unmark _swap
bindsym $mod+Ctrl+$down mark --add --replace _swap; focus down; swap container with mark _swap; [con_mark="^_swap$"] focus; unmark _swap
bindsym $mod+Ctrl+$up mark --add --replace _swap; focus up; swap container with mark _swap; [con_mark="^_swap$"] focus; unmark _swap
bindsym $mod+Ctrl+$right mark --add --replace _swap; focus right; swap container with mark _swap; [con_mark="^_swap$"] focus; unmark _swap

bindsym $mod+bracketleft focus output left
bindsym $mod+bracketright focus output right
bindsym $mod+Shift+bracketleft move container to output left; focus output left
bindsym $mod+Shift+bracketright move container to output right; focus output right

bindsym $mod+q exec ~/.cargo/bin/sway-easyfocus

workspace_auto_back_and_forth yes

set $ws ~/.config/sway/scripts/sh/workspace.sh
bindsym $mod+1 exec $ws switch 1
bindsym $mod+2 exec $ws switch 2
bindsym $mod+3 exec $ws switch 3
bindsym $mod+4 exec $ws switch 4
bindsym $mod+5 exec $ws switch 5
bindsym $mod+6 exec $ws switch 6
bindsym $mod+7 exec $ws switch 7
bindsym $mod+8 exec $ws switch 8
bindsym $mod+9 exec $ws switch 9
bindsym $mod+0 exec $ws switch 10
bindsym $mod+Shift+1 exec $ws move 1
bindsym $mod+Shift+2 exec $ws move 2
bindsym $mod+Shift+3 exec $ws move 3
bindsym $mod+Shift+4 exec $ws move 4
bindsym $mod+Shift+5 exec $ws move 5
bindsym $mod+Shift+6 exec $ws move 6
bindsym $mod+Shift+7 exec $ws move 7
bindsym $mod+Shift+8 exec $ws move 8
bindsym $mod+Shift+9 exec $ws move 9
bindsym $mod+Shift+0 exec $ws move 10

bindsym --whole-window $mod+button4 exec $ws next
bindsym --whole-window $mod+button5 exec $ws prev

bindsym $mod+v exec ~/.config/sway/scripts/sh/clipboard.sh
bindsym $mod+t layout toggle tabbed split
bindsym $mod+Tab focus parent
bindsym $mod+Shift+Tab focus child

bindsym $mod+f fullscreen
bindsym $mod+z exec ~/.config/sway/scripts/sh/toggle-floating.sh
bindsym $mod+space focus mode_toggle

# Alt-Tab
bindsym Mod1+Tab exec ~/.config/sway/scripts/sh/alt-tab.sh next
bindsym Mod1+Shift+Tab exec ~/.config/sway/scripts/sh/alt-tab.sh prev
bindsym $mod+p exec ~/.config/sway/scripts/sh/modal.sh audio-switcher
bindsym $mod+Shift+p exec ~/.config/sway/scripts/sh/modal.sh pipewire-mixer
bindsym $mod+Shift+w exec ~/.config/sway/scripts/sh/modal.sh wallpaper
bindsym $mod+i exec ~/.config/sway/scripts/sh/toggle-sys-info.sh
bindsym $mod+n exec ~/.config/sway/scripts/sh/toggle-night-light.sh
bindsym $mod+grave exec ~/.config/sway/scripts/sh/jot-scratch.sh
bindsym $mod+c exec ~/.config/sway/scripts/sh/modal.sh calculator
bindsym $mod+b exec ~/.config/sway/scripts/sh/window-picker.sh

# Screen recording
bindsym $mod+Shift+r exec ~/.config/sway/scripts/sh/record-screen.sh

# Window marks
include marks.conf

bindsym $mod+r mode "resize"
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Utilities
bindsym $mod+x exec ~/.config/sway/scripts/sh/modal.sh powermenu
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | tee "$HOME/Obrazy/Zrzuty ekranu/Zrzut ekranu_$(date +'%Y%m%d_%H%M%S').png" | wl-copy -t image/png

bindsym Scroll_Lock exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym Pause exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+

# Tiling / Floating rules
# Managed by tiled_apps.list
include tiled.conf

# Special sizes and positions
for_window [app_id="pavucontrol"] resize set 700 500, move position center
for_window [app_id="gwenview"] resize set 900 600, move position center
for_window [app_id="carmenta"] move position center
for_window [app_id="steam"] resize set 900 600, move position center
for_window [app_id="dolphin"] resize set 1100 900, move position center
for_window [app_id="plasma-systemmonitor"] resize set 1050 700, move position center
for_window [app_id="org.kde.plasma-systemmonitor"] resize set 1050 700, move position center
# Let Firefox draw late in the frame too (I type there)
for_window [app_id="org.mozilla.firefox"] max_render_time 3
for_window [app_id="ghostty" app_id="floating_nmtui"] floating enable, resize set 750 450, move position center
for_window [app_id="emacs" title="^jot-scratch$"] mark "jot_scratch", move scratchpad, scratchpad show, resize set 1000 700, move position center

# Styling
default_border pixel 2
default_floating_border normal 2
for_window [floating] border normal 2
titlebar_padding 8 5
title_align center
for_window [title=".*"] title_format "%title"
for_window [app_id="firefox"] title_format "Mozilla Firefox"

# Modals of sway/scripts
for_window [app_id="sway-sys-info"] floating enable, border pixel 2, move position center
for_window [app_id="sway-mixer"] floating enable, border pixel 2, move position center
for_window [app_id="sway-audio-switcher"] floating enable, border pixel 2, move position center
for_window [app_id="sway-powermenu"] floating enable, border pixel 2, move position center
for_window [app_id="sway-wallpaper"] floating enable, border pixel 2, move position center
for_window [app_id="sway-calculator"] floating enable, border pixel 2, move position center
for_window [app_id="sway-net-info"] floating enable, border pixel 2, move position center

font pango:Typus Mono 95, JetBrainsMono Nerd Font 11

# Window Colors (managed by dotfiles/theme/colors.sh)
include colors.conf

# SwayOSD Integration
exec swayosd-server

bindsym --locked XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym --locked XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym --locked XF86AudioMicMute exec swayosd-client --input-volume mute-toggle

# Idle management
exec swayidle -w timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"'
exec ~/.cargo/bin/wayland-pipewire-idle-inhibit

exec ~/.config/sway/scripts/sh/workspace-init.sh

# Cursor lock
for_window [class="steam_app_.*"] {
    floating enable
    border none
    inhibit_idle focus
}

no_focus [app_id="swaync-control-center"]
no_focus [app_id="swaync-notification-window"]
no_focus [class="steam" instance="steamwebhelper"]

include /etc/sway/config.d/*
