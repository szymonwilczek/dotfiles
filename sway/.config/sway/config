### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $menu fuzzel
set $explorer QT_QPA_PLATFORMTHEME=kde dolphin

# Execs
exec swaync
exec_always sh -c "killall waybar 2>/dev/null; sleep 0.5; env LC_ALL=pl_PL.UTF-8 waybar"

# Output configuration
output * bg ~/Pulpit/Personalne/Tapety/IMG_1692_lossless.png fill
output * subpixel rgb
# output * render_bit_depth 10
output HDMI-A-1 mode 1920x1080@75Hz pos 0 0
output DP-2 mode 1920x1080@179.821Hz pos 1920 0
output DP-1 mode 1600x900@77Hz pos 3840 0

# Per-monitor workspaces to outputs
workspace "DP-2:1" output DP-2
workspace "DP-2:2" output DP-2
workspace "DP-2:3" output DP-2
workspace "DP-2:4" output DP-2
workspace "DP-2:5" output DP-2
workspace "DP-2:6" output DP-2
workspace "DP-2:7" output DP-2
workspace "DP-2:8" output DP-2
workspace "DP-2:9" output DP-2
workspace "DP-2:10" output DP-2
workspace "HDMI-A-1:1" output HDMI-A-1
workspace "HDMI-A-1:2" output HDMI-A-1
workspace "HDMI-A-1:3" output HDMI-A-1
workspace "HDMI-A-1:4" output HDMI-A-1
workspace "HDMI-A-1:5" output HDMI-A-1
workspace "HDMI-A-1:6" output HDMI-A-1
workspace "HDMI-A-1:7" output HDMI-A-1
workspace "HDMI-A-1:8" output HDMI-A-1
workspace "HDMI-A-1:9" output HDMI-A-1
workspace "HDMI-A-1:10" output HDMI-A-1
workspace "DP-1:1" output DP-1
workspace "DP-1:2" output DP-1
workspace "DP-1:3" output DP-1
workspace "DP-1:4" output DP-1
workspace "DP-1:5" output DP-1
workspace "DP-1:6" output DP-1
workspace "DP-1:7" output DP-1
workspace "DP-1:8" output DP-1
workspace "DP-1:9" output DP-1
workspace "DP-1:10" output DP-1

# Seat & Cursor configuration
seat * xcursor_theme Adwaita 16
exec_always gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'
exec_always gsettings set org.gnome.desktop.interface cursor-size 16

# Gaps & Borders configuration
smart_gaps on
hide_edge_borders smart

# Idle configuration
# Im not using it, but maybe someday

# Input configuration
input type:keyboard {
    xkb_layout "pl"
    xkb_options caps:ctrl_modifier
    repeat_delay 180
    repeat_rate 38
}

input type:pointer {
    pointer_accel 0.0
    accel_profile flat
}

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec emacsclient -c -a ''
bindsym $mod+Shift+q kill
bindsym $mod+a kill
bindsym $mod+s exec $menu
bindsym $mod+e exec $explorer
bindsym $mod+period exec carmenta --vim --disable-gifs --close-on-select --scale 1.15

floating_modifier $mod normal

bindsym $mod+Shift+c exec pkill -9 -f emacs 2>/dev/null; reload

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

set $ws ~/.config/sway/scripts/workspace.sh
bindsym $mod+1 exec $ws switch 1
bindsym $mod+2 exec $ws switch 2
bindsym $mod+3 exec $ws switch 3
bindsym $mod+4 exec $ws switch 4
bindsym $mod+5 exec $ws switch 5
bindsym $mod+6 exec $ws switch 6
bindsym $mod+7 exec $ws switch 7
bindsym $mod+8 exec $ws switch 8
bindsym $mod+9 exec $ws switch 9
bindsym $mod+0 exec $ws switch 10
bindsym $mod+Shift+1 exec $ws move 1
bindsym $mod+Shift+2 exec $ws move 2
bindsym $mod+Shift+3 exec $ws move 3
bindsym $mod+Shift+4 exec $ws move 4
bindsym $mod+Shift+5 exec $ws move 5
bindsym $mod+Shift+6 exec $ws move 6
bindsym $mod+Shift+7 exec $ws move 7
bindsym $mod+Shift+8 exec $ws move 8
bindsym $mod+Shift+9 exec $ws move 9
bindsym $mod+Shift+0 exec $ws move 10

bindsym --whole-window $mod+button4 exec $ws next
bindsym --whole-window $mod+button5 exec $ws prev

bindsym $mod+b splith
bindsym $mod+v splitv

# bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed

bindsym $mod+f fullscreen
bindsym $mod+z exec ~/.config/sway/scripts/toggle-floating.sh
bindsym $mod+space focus mode_toggle

# Alt-Tab
bindsym Mod1+Tab exec ~/.config/sway/scripts/alt-tab.sh next
bindsym Mod1+Shift+Tab exec ~/.config/sway/scripts/alt-tab.sh prev
bindsym $mod+p exec ~/.config/sway/scripts/audio-switcher.sh
bindsym $mod+Mod5+p exec ~/.config/sway/scripts/toggle-pipewire-mixer.sh
bindsym $mod+i exec ~/.config/sway/scripts/toggle-sys-info.sh
bindsym $mod+grave exec ~/.config/sway/scripts/scratchpad-ghostty.sh

# Screen recording & Drawing
bindsym $mod+Shift+r exec ~/.config/sway/scripts/record-screen.sh
bindsym $mod+Shift+t exec ~/.config/sway/scripts/toggle-drawing.sh

# Gromit-MPX
bindsym F9 exec gromit-mpx --toggle
bindsym Shift+F9 exec gromit-mpx --clear
bindsym Ctrl+F9 exec gromit-mpx --visibility
bindsym Alt+F9 exec gromit-mpx --quit

for_window [app_id="Gromit-mpx"] floating enable, border none, sticky enable
for_window [class="Gromit-mpx"] floating enable, border none, sticky enable

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

bindsym $mod+r mode "resize"
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Utilities
bindsym $mod+x exec ~/.config/sway/scripts/powermenu.sh
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | tee "$HOME/Obrazy/Zrzuty ekranu/Zrzut ekranu_$(date +'%Y%m%d_%H%M%S').png" | wl-copy -t image/png

bindsym Scroll_Lock exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym Pause exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+

# Floating Rules
for_window [app_id="pavucontrol"] floating enable, resize set 700 500, move position center
for_window [app_id="gwenview"] floating enable, resize set 900 600, move position center
for_window [app_id="carmenta"] floating enable, move position center
for_window [app_id="steam"] floating enable, resize set 900 600, move position center
for_window [app_id="dolphin"] floating enable, resize set 1100 900, move position center
for_window [app_id="ghostty" app_id="floating_nmtui"] floating enable, resize set 750 450, move position center
for_window [title="Scratchpad Ghostty"] floating enable, mark "scratchpad_ghostty", move scratchpad
for_window [title="Informacje"] floating enable, border pixel 0, move position center
for_window [title="AudioMixer"] floating enable, border pixel 0, move position center

# Styling
default_border pixel 2
default_floating_border normal 2
for_window [floating] border normal 2
titlebar_padding 8 5
title_align center
for_window [title=".*"] title_format "%title"
for_window [app_id="firefox"] title_format "Mozilla Firefox"
font pango:Typus Mono 95, JetBrainsMono Nerd Font 11

# Window Colors (managed by dotfiles/theme/colors.sh)
include colors.conf

# SwayOSD Integration
exec_always pkill -x swayosd-server 2>/dev/null; swayosd-server &

bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym --release Caps_Lock exec swayosd-client --caps-lock

# Idle management
exec swayidle -w timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"'

exec_always ~/.config/sway/scripts/workspace-init.sh

include /etc/sway/config.d/*
